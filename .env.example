# Copy to .env and adjust. Every S1_* variable maps to systemone/config.py.

# --- Redis (required): generate with `openssl rand -hex 24` (keep it URL-safe)
S1_REDIS_PASSWORD=
# --- LAN API (required when S1_BIND_ADDR is not loopback: the API refuses to
# start otherwise). Generate with `openssl rand -hex 32`.
S1_API_KEY=
# Bind address for the API and dashboard. Default is loopback only; set to
# 0.0.0.0 to serve the LAN (only with S1_API_KEY set to a real secret).
# S1_BIND_ADDR=127.0.0.1
# Published ports (the dashboard is built to call S1_API_PORT; rebuild it after changing)
# S1_API_PORT=8090
# S1_DASHBOARD_PORT=3090
# S1_STUDENT_PORT=8091
# S1_TRIAGE_PORT=8092
# --- Mac M4 Max oracle (Ollama must listen on the LAN: OLLAMA_HOST=0.0.0.0)
S1_ORACLE_URL=http://192.168.1.50:11434
S1_ORACLE_MODEL=qwen3.8:27b
S1_ORACLE_VISION_MODEL=
# --- BYOM
S1_STUDENT_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
S1_TRIAGE_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
HF_TOKEN=
# --- GPUs (PCI bus order, as in nvidia-smi)
# S1_STUDENT_GPU=0
# S1_TRIAGE_GPU=1
# --- Pinned base images (set to the versions you validated; see docs/hardware.md)
# S1_VLLM_VERSION=latest
# --- Storage (leave unset: Docker named volume on fast native disk)
# S1_WORKSPACE_VOLUME=systemone-workspace
# --- vLLM CPU KV offload (GB). Unset = 32/16 on Linux, 0 on WSL2. Raise gradually
# on WSL2 while watching vmmemWSL; the launcher also probes and shrinks it.
# S1_KV_OFFLOAD_GB=0
# S1_TRIAGE_KV_OFFLOAD_GB=0
# S1_STUDENT_START_TIMEOUT_S=1800
# --- Container memory limits (tune to your WSL2 / host RAM)
# S1_REDIS_MEM_LIMIT=40g
# S1_STUDENT_MEM_LIMIT=48g
# S1_TRIAGE_MEM_LIMIT=32g
# S1_API_MEM_LIMIT=4g
# S1_DASHBOARD_MEM_LIMIT=1g
# S1_TRAINER_MEM_LIMIT=48g
# S1_TRAINER_SHM_SIZE=8g
# --- GPU 0 flush check: free VRAM needed before training / reloading (WSL2: Windows holds some)
# S1_VRAM_REQUIRED_FREE_MB=21000
